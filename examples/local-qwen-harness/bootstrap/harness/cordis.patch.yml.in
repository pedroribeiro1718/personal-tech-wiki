- id: web
  config:
    searchProvider: searxng

- id: web-search-deepseek
  disabled: true

- id: web-search-searxng
  config:
    baseURL: http://127.0.0.1:8888

- id: tool-web
  disabled: true

- insert:
    - id: mcp-fetch
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: fetch
        transport: stdio
        command: __NODE_BIN__
        args:
          - __PROFILE_DIR__/node_modules/@j0hanz/fetch-url-mcp/dist/index.js
        cwd: __PROFILE_DIR__
        toolCallTimeoutMs: 30000
        failOnStartupError: true
