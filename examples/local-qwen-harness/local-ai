#!/usr/bin/env bash
set -euo pipefail
umask 077

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
STACK_DIR="$(cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd)"
QWEN_CONTAINER="qwen38"
QWEN_URL="http://127.0.0.1:30000/v1/models"
QWEN_FULL_CONTAINER="qwen38-full"
QWEN_FULL_URL="http://127.0.0.1:30000/v1/models"
QWEN_FULL_PATCH_COMMIT="8558b8ca3bba028f852f4b53167b79b4cd552f93"
QWEN_FULL_PATCH_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/local-qwen-harness/qwen38-exl3-${QWEN_FULL_PATCH_COMMIT:0:12}"
QWEN_FULL_PATCH_BASE="https://raw.githubusercontent.com/malaiwah/qwen38-27b-exl3/${QWEN_FULL_PATCH_COMMIT}/tools"
QWEN_NINFER_CONTAINER="qwen38-ninfer"
QWEN_NINFER_URL="http://127.0.0.1:30000/v1/models"
QWEN_NINFER_SOURCE_COMMIT="a140e7ae82a11ed2f370a4d8f2cc16268a3790b8"
QWEN_NINFER_SOURCE_URL="https://github.com/Neroued/ninfer.git"
QWEN_NINFER_SOURCE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/local-qwen-harness/ninfer-${QWEN_NINFER_SOURCE_COMMIT:0:12}"
QWEN_NINFER_IMAGE="local/qwen-ninfer:${QWEN_NINFER_SOURCE_COMMIT:0:12}"
QWEN_NINFER_MODEL_REVISION="204e3d92c30d9d05f3300d2f52e443ad1edf6ddf"
QWEN_NINFER_MODEL_SHA256="bb3360522a06e136e0367f5703414d26272b7285c8a6ab6194135c17dbd81b32"
QWEN_NINFER_MODEL_SIZE="21492695040"
QWEN_NINFER_MODEL_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/local-qwen-harness/ninfer-model-${QWEN_NINFER_MODEL_REVISION:0:12}"
QWEN_NINFER_MODEL_FILE="${QWEN_NINFER_MODEL_DIR}/qwen3_8_27b_nvfp4.ninfer"
QWEN_NINFER_MODEL_URL="https://huggingface.co/neroued/Qwen3.8-27B-nvfp4-NInfer/resolve/${QWEN_NINFER_MODEL_REVISION}/qwen3_8_27b_nvfp4.ninfer?download=true"
HARNESS_URL="http://127.0.0.1:3080"
DSH_PACKAGE="@deepseek-ai/dsh@0.1.1-rc.2"
HARNESS_UNIT="local-qwen-harness.service"

start_qwen() {
  if container_running "${QWEN_FULL_CONTAINER}" || container_running "${QWEN_NINFER_CONTAINER}"; then
    printf 'Another Qwen recipe is already using the GPU. Run: local-ai stop qwen\n' >&2
    return 1
  fi
  if docker container inspect "${QWEN_CONTAINER}" >/dev/null 2>&1; then
    docker start "${QWEN_CONTAINER}" >/dev/null
  else
    docker compose -f "${STACK_DIR}/qwen.compose.yaml" up -d qwen
  fi
}

container_running() {
  [[ "$(docker container inspect --format '{{.State.Running}}' "$1" 2>/dev/null || true)" == "true" ]]
}

wait_for_model() {
  local label="$1"
  local url="$2"
  local attempts="$3"
  local container_name="$4"

  printf 'Waiting for %s to become ready' "${label}"
  for _ in $(seq 1 "${attempts}"); do
    if curl -fsS --max-time 2 "${url}" >/dev/null 2>&1; then
      printf '\n%s is ready: %s\n' "${label}" "${url}"
      return 0
    fi
    printf '.'
    sleep 2
  done
  printf '\n%s did not become ready. Inspect: docker logs %s\n' \
    "${label}" "${container_name}" >&2
  return 1
}

wait_for_qwen() {
  wait_for_model "Qwen" "${QWEN_URL}" 180 "${QWEN_CONTAINER}"
}

verify_full_patches() {
  local patch_root="$1"
  local failed=0

  printf '%s  %s\n' \
    2df9d0799fd323798cead1edb773cab556c94798eec263ee03ded35408c6e4ee \
    "${patch_root}/tools/vllm-exl3-prefill-dispatch.py" | sha256sum -c - >/dev/null || failed=1
  printf '%s  %s\n' \
    04d2bd587b37142f4f55a8d00b9f8c907309490168cb7fcdfde450531df2c9e7 \
    "${patch_root}/tools/vllm-qwen3_5-embed-quant-config.py" | sha256sum -c - >/dev/null || failed=1
  printf '%s  %s\n' \
    0090dc131f0eaf439b24d50baf4def9f10b052864c76e695053d64f66b274bab \
    "${patch_root}/tools/vllm-qwen3_5_mtp-embed-quant-config.py" | sha256sum -c - >/dev/null || failed=1
  printf '%s  %s\n' \
    b431c1066dfee3ed56bfa7e71cc8606f9afadc300f22d7fc542c43835d1b22bf \
    "${patch_root}/tools/vllm-mamba-align-scheduler.py" | sha256sum -c - >/dev/null || failed=1
  return "${failed}"
}

ensure_full_patches() {
  local temp_dir
  local filename

  if verify_full_patches "${QWEN_FULL_PATCH_DIR}" 2>/dev/null; then
    return 0
  fi
  if [[ -e "${QWEN_FULL_PATCH_DIR}" ]]; then
    printf 'Existing full-context patch cache failed verification: %s\n' "${QWEN_FULL_PATCH_DIR}" >&2
    printf 'Move it aside, then run: local-ai prepare exl3\n' >&2
    return 1
  fi

  mkdir -p "$(dirname -- "${QWEN_FULL_PATCH_DIR}")"
  temp_dir="$(mktemp -d "$(dirname -- "${QWEN_FULL_PATCH_DIR}")/.qwen-full-patches.XXXXXX")"
  mkdir -p "${temp_dir}/tools"
  for filename in \
    vllm-exl3-prefill-dispatch.py \
    vllm-qwen3_5-embed-quant-config.py \
    vllm-qwen3_5_mtp-embed-quant-config.py \
    vllm-mamba-align-scheduler.py; do
    if ! curl -fL --retry 3 --output "${temp_dir}/tools/${filename}" \
      "${QWEN_FULL_PATCH_BASE}/${filename}"; then
      rm -rf -- "${temp_dir}"
      return 1
    fi
  done
  if ! verify_full_patches "${temp_dir}"; then
    rm -rf -- "${temp_dir}"
    printf 'Downloaded full-context patches failed checksum verification.\n' >&2
    return 1
  fi
  mv -- "${temp_dir}" "${QWEN_FULL_PATCH_DIR}"
  printf 'Verified full-context runtime overlays at %s\n' "${QWEN_FULL_PATCH_DIR}"
}

full_compose() {
  QWEN_FULL_PATCH_DIR="${QWEN_FULL_PATCH_DIR}" \
    docker compose -f "${STACK_DIR}/qwen-full.compose.yaml" "$@"
}

prepare_qwen_full() {
  ensure_full_patches
  docker volume inspect qwen38-full-hf-cache >/dev/null 2>&1 || \
    docker volume create qwen38-full-hf-cache >/dev/null
  full_compose pull qwen-full
  printf 'exl3 recipe is prepared. Model weights download on first start.\n'
}

check_qwen_full_memory() {
  local total_mib
  local free_mib
  local required_mib

  if ! IFS=, read -r total_mib free_mib < <(
    nvidia-smi --query-gpu=memory.total,memory.free --format=csv,noheader,nounits 2>/dev/null
  ); then
    printf 'Cannot query the NVIDIA GPU; qwen-full startup was not attempted.\n' >&2
    return 1
  fi
  required_mib=$((total_mib * 955 / 1000))
  if (( free_mib < required_mib )); then
    printf 'qwen-full needs about %s MiB free for gpu-memory-utilization=0.955; only %s MiB is free.\n' \
      "${required_mib}" "${free_mib}" >&2
    printf 'Close GPU applications and stop the graphical session before retrying; startup was not attempted.\n' >&2
    return 1
  fi
}

start_qwen_full() {
  if container_running "${QWEN_CONTAINER}" || container_running "${QWEN_NINFER_CONTAINER}"; then
    printf 'Another Qwen recipe is already using the GPU. Run: local-ai stop qwen\n' >&2
    return 1
  fi
  check_qwen_full_memory
  ensure_full_patches
  full_compose up -d qwen-full
  wait_for_model "Qwen full-context" "${QWEN_FULL_URL}" 450 "${QWEN_FULL_CONTAINER}"
}

ensure_ninfer_source() {
  local temp_dir
  local source_head
  local source_status

  if [[ -d "${QWEN_NINFER_SOURCE_DIR}/.git" ]]; then
    source_head="$(git -C "${QWEN_NINFER_SOURCE_DIR}" rev-parse HEAD 2>/dev/null || true)"
    source_status="$(git -C "${QWEN_NINFER_SOURCE_DIR}" status --porcelain --untracked-files=normal 2>/dev/null || true)"
    if [[ "${source_head}" == "${QWEN_NINFER_SOURCE_COMMIT}" && -z "${source_status}" ]]; then
      return 0
    fi
    printf 'Existing NInfer source cache is modified or not at the pinned revision: %s\n' \
      "${QWEN_NINFER_SOURCE_DIR}" >&2
    printf 'Move it aside, then run: local-ai prepare ninfer\n' >&2
    return 1
  fi
  if [[ -e "${QWEN_NINFER_SOURCE_DIR}" ]]; then
    printf 'NInfer source cache path exists but is not a Git checkout: %s\n' \
      "${QWEN_NINFER_SOURCE_DIR}" >&2
    return 1
  fi

  mkdir -p "$(dirname -- "${QWEN_NINFER_SOURCE_DIR}")"
  temp_dir="$(mktemp -d "$(dirname -- "${QWEN_NINFER_SOURCE_DIR}")/.ninfer-source.XXXXXX")"
  if ! git clone --filter=blob:none --no-checkout \
    "${QWEN_NINFER_SOURCE_URL}" "${temp_dir}/source"; then
    rm -rf -- "${temp_dir}"
    return 1
  fi
  if ! git -C "${temp_dir}/source" checkout --detach "${QWEN_NINFER_SOURCE_COMMIT}"; then
    rm -rf -- "${temp_dir}"
    return 1
  fi
  mv -- "${temp_dir}/source" "${QWEN_NINFER_SOURCE_DIR}"
  rmdir -- "${temp_dir}"
  printf 'Pinned NInfer source at %s\n' "${QWEN_NINFER_SOURCE_DIR}"
}

verify_ninfer_model() {
  [[ -f "${QWEN_NINFER_MODEL_FILE}" ]] || return 1
  [[ "$(stat -c '%s' "${QWEN_NINFER_MODEL_FILE}")" == "${QWEN_NINFER_MODEL_SIZE}" ]] || return 1
  printf '%s  %s\n' "${QWEN_NINFER_MODEL_SHA256}" "${QWEN_NINFER_MODEL_FILE}" | \
    sha256sum -c - >/dev/null
}

ensure_ninfer_model() {
  local current_size=0

  if verify_ninfer_model; then
    return 0
  fi
  if [[ -f "${QWEN_NINFER_MODEL_FILE}" ]]; then
    current_size="$(stat -c '%s' "${QWEN_NINFER_MODEL_FILE}")"
    if (( current_size >= QWEN_NINFER_MODEL_SIZE )); then
      printf 'Existing NInfer artifact failed size or checksum verification: %s\n' \
        "${QWEN_NINFER_MODEL_FILE}" >&2
      printf 'Move it aside, then run: local-ai prepare ninfer\n' >&2
      return 1
    fi
    printf 'Resuming NInfer model download at %s of %s bytes.\n' \
      "${current_size}" "${QWEN_NINFER_MODEL_SIZE}"
  fi

  mkdir -p "${QWEN_NINFER_MODEL_DIR}"
  if command -v aria2c >/dev/null 2>&1; then
    aria2c --continue=true --auto-file-renaming=false --file-allocation=none \
      --max-connection-per-server=4 --split=4 \
      --dir="${QWEN_NINFER_MODEL_DIR}" --out="$(basename -- "${QWEN_NINFER_MODEL_FILE}")" \
      "${QWEN_NINFER_MODEL_URL}"
  else
    curl -fL --retry 3 --continue-at - --output "${QWEN_NINFER_MODEL_FILE}" \
      "${QWEN_NINFER_MODEL_URL}"
  fi
  if ! verify_ninfer_model; then
    printf 'Downloaded NInfer artifact failed size or checksum verification: %s\n' \
      "${QWEN_NINFER_MODEL_FILE}" >&2
    return 1
  fi
  printf 'Verified NInfer model artifact at %s\n' "${QWEN_NINFER_MODEL_FILE}"
}

ensure_ninfer_image() {
  local image_revision

  image_revision="$(docker image inspect --format \
    '{{ index .Config.Labels "org.opencontainers.image.revision" }}' \
    "${QWEN_NINFER_IMAGE}" 2>/dev/null || true)"
  if [[ "${image_revision}" == "${QWEN_NINFER_SOURCE_COMMIT}" ]]; then
    return 0
  fi
  ensure_ninfer_source
  docker build \
    --build-arg "NINFER_SOURCE_REVISION=${QWEN_NINFER_SOURCE_COMMIT}" \
    --file "${STACK_DIR}/ninfer.Dockerfile" \
    --tag "${QWEN_NINFER_IMAGE}" \
    "${QWEN_NINFER_SOURCE_DIR}"
}

ninfer_compose() {
  QWEN_NINFER_MODEL_FILE="${QWEN_NINFER_MODEL_FILE}" \
    docker compose -f "${STACK_DIR}/qwen-ninfer.compose.yaml" "$@"
}

prepare_qwen_ninfer() {
  ensure_ninfer_source
  ensure_ninfer_image
  ensure_ninfer_model
  printf 'ninfer recipe is prepared. Nothing was started.\n'
}

check_qwen_ninfer_memory() {
  local total_mib
  local free_mib
  local required_mib

  if ! IFS=, read -r total_mib free_mib < <(
    nvidia-smi --query-gpu=memory.total,memory.free --format=csv,noheader,nounits 2>/dev/null
  ); then
    printf 'Cannot query the NVIDIA GPU; qwen-ninfer startup was not attempted.\n' >&2
    return 1
  fi
  required_mib=$((total_mib - 1080))
  if (( free_mib < required_mib )); then
    printf 'qwen-ninfer needs approximately %s MiB free for its qualified 252,928-token profile; only %s MiB is free.\n' \
      "${required_mib}" "${free_mib}" >&2
    printf 'Close GPU applications and stop the graphical session before retrying; startup was not attempted.\n' >&2
    return 1
  fi
}

start_qwen_ninfer() {
  if container_running "${QWEN_CONTAINER}" || container_running "${QWEN_FULL_CONTAINER}"; then
    printf 'Another Qwen recipe is already using the GPU. Run: local-ai stop qwen\n' >&2
    return 1
  fi
  check_qwen_ninfer_memory
  ensure_ninfer_source
  ensure_ninfer_image
  ensure_ninfer_model
  ninfer_compose up -d qwen-ninfer
  wait_for_model "Qwen NInfer" "${QWEN_NINFER_URL}" 450 "${QWEN_NINFER_CONTAINER}"
}

prepare_qwen_sglang() {
  docker volume inspect qwen38-hf-cache >/dev/null 2>&1 || \
    docker volume create qwen38-hf-cache >/dev/null
  docker compose -f "${STACK_DIR}/qwen.compose.yaml" pull qwen
  printf 'sglang recipe is prepared. Nothing was started.\n'
}

start_harness() {
  local pnpm_bin

  if systemctl --user is-active --quiet "${HARNESS_UNIT}"; then
    printf 'Harness is already running: %s\n' "${HARNESS_URL}"
    return 0
  fi

  if curl -fsS --max-time 2 "${HARNESS_URL}" >/dev/null 2>&1; then
    printf 'Port 3080 already has an unmanaged Harness listener; refusing to start a duplicate.\n' >&2
    return 1
  fi

  pnpm_bin="$(command -v pnpm)"
  systemctl --user reset-failed "${HARNESS_UNIT}" >/dev/null 2>&1 || true
  printf 'Starting Harness in the background: %s\n' "${HARNESS_URL}"
  systemd-run --user --quiet --collect \
    --unit="${HARNESS_UNIT}" \
    --property=Type=exec \
    --property=KillMode=control-group \
    --property=TimeoutStopSec=15 \
    --working-directory="${HOME}" \
    --setenv="QWEN_LOCAL_API_KEY=${QWEN_LOCAL_API_KEY:-local-no-key}" \
    "${pnpm_bin}" dlx "${DSH_PACKAGE}" web --no-open

  for _ in $(seq 1 30); do
    if ! systemctl --user is-active --quiet "${HARNESS_UNIT}"; then
      printf 'Harness exited during startup. Recent log output:\n' >&2
      journalctl --user -u "${HARNESS_UNIT}" -n 40 --no-pager >&2 || true
      return 1
    fi
    if curl -fsS --max-time 2 "${HARNESS_URL}" >/dev/null 2>&1; then
      printf 'Harness is ready. View logs with: local-ai logs\n'
      return 0
    fi
    sleep 1
  done

  printf 'Harness did not become ready within 30 seconds. Run: local-ai logs\n' >&2
  return 1
}

stop_harness() {
  if ! systemctl --user is-active --quiet "${HARNESS_UNIT}"; then
    if curl -fsS --max-time 2 "${HARNESS_URL}" >/dev/null 2>&1; then
      printf 'Harness is running but is not managed by this helper; leaving it untouched.\n' >&2
      return 1
    fi
    printf 'Harness is already stopped.\n'
    return 0
  fi

  systemctl --user stop "${HARNESS_UNIT}"
  printf 'Harness stopped.\n'
}

validate_targets() {
  local target_name

  for target_name in "$@"; do
    case "${target_name}" in
      qwen|harness|searxng|all) ;;
      *)
        printf 'Unknown target: %s (expected qwen, harness, searxng, or all)\n' "${target_name}" >&2
        return 2
        ;;
    esac
  done
}

target_requested() {
  local requested_target="$1"
  local target_name
  shift

  for target_name in "$@"; do
    if [[ "${target_name}" == "${requested_target}" || "${target_name}" == "all" ]]; then
      return 0
    fi
  done
  return 1
}

validate_recipe() {
  case "$1" in
    sglang|exl3|ninfer) ;;
    *)
      printf 'Unknown Qwen recipe: %s (expected sglang, exl3, or ninfer)\n' "$1" >&2
      return 2
      ;;
  esac
}

SELECTED_RECIPE=""
PARSED_TARGETS=()

parse_service_arguments() {
  local mode="$1"
  shift

  SELECTED_RECIPE=""
  PARSED_TARGETS=()
  while (( $# > 0 )); do
    case "$1" in
      --recipe)
        shift
        if (( $# == 0 )); then
          printf '%s requires a value: sglang, exl3, or ninfer\n' --recipe >&2
          return 2
        fi
        SELECTED_RECIPE="$1"
        ;;
      --recipe=*)
        SELECTED_RECIPE="${1#--recipe=}"
        ;;
      --*)
        printf 'Unknown option: %s\n' "$1" >&2
        return 2
        ;;
      *)
        PARSED_TARGETS+=("$1")
        ;;
    esac
    shift
  done

  if [[ -n "${SELECTED_RECIPE}" ]]; then
    validate_recipe "${SELECTED_RECIPE}"
  elif [[ "${mode}" == "start" ]]; then
    SELECTED_RECIPE="sglang"
  fi
  if (( ${#PARSED_TARGETS[@]} == 0 )); then
    PARSED_TARGETS=(all)
  fi
  validate_targets "${PARSED_TARGETS[@]}"
}

start_targets() {
  local recipe="$1"
  shift

  validate_targets "$@"
  validate_recipe "${recipe}"

  if target_requested searxng "$@"; then
    docker compose -f "${STACK_DIR}/compose.yaml" up -d searxng
  fi
  if target_requested qwen "$@"; then
    case "${recipe}" in
      sglang)
        start_qwen
        wait_for_qwen
        ;;
      exl3) start_qwen_full ;;
      ninfer) start_qwen_ninfer ;;
    esac
  fi
  if target_requested harness "$@"; then
    start_harness
  fi
}

model_start() {
  start_qwen
  wait_for_qwen
}

model_stop() {
  stop_targets "" qwen
}

stop_targets() {
  local recipe="$1"
  shift
  local stop_result=0

  validate_targets "$@"

  if target_requested harness "$@"; then
    stop_harness || stop_result=$?
  fi
  if target_requested qwen "$@"; then
    case "${recipe}" in
      sglang)
        docker stop "${QWEN_CONTAINER}" >/dev/null 2>&1 || true
        printf 'Qwen sglang stopped; its CUDA allocation has been released.\n'
        ;;
      exl3)
        docker stop --time 60 "${QWEN_FULL_CONTAINER}" >/dev/null 2>&1 || true
        printf 'Qwen EXL3 stopped; its CUDA allocation has been released.\n'
        ;;
      ninfer)
        docker stop --time 60 "${QWEN_NINFER_CONTAINER}" >/dev/null 2>&1 || true
        printf 'Qwen NInfer stopped; its CUDA allocation has been released.\n'
        ;;
      "")
        docker stop "${QWEN_CONTAINER}" >/dev/null 2>&1 || true
        docker stop --time 60 "${QWEN_FULL_CONTAINER}" >/dev/null 2>&1 || true
        docker stop --time 60 "${QWEN_NINFER_CONTAINER}" >/dev/null 2>&1 || true
        printf 'All Qwen recipes stopped; their CUDA allocations have been released.\n'
        ;;
    esac
  fi
  if target_requested searxng "$@"; then
    docker compose -f "${STACK_DIR}/compose.yaml" stop searxng >/dev/null
    printf 'SearXNG stopped.\n'
  fi
  return "${stop_result}"
}

status() {
  if systemctl --user is-active --quiet "${HARNESS_UNIT}"; then
    printf 'Harness: running at %s\n\n' "${HARNESS_URL}"
  elif curl -fsS --max-time 2 "${HARNESS_URL}" >/dev/null 2>&1; then
    printf 'Harness: responding at %s, but not managed by this helper\n\n' "${HARNESS_URL}"
  else
    printf 'Harness: stopped\n\n'
  fi
  docker ps -a --filter "name=^/${QWEN_CONTAINER}$" --filter "name=^/${QWEN_FULL_CONTAINER}$" \
    --filter "name=^/${QWEN_NINFER_CONTAINER}$" \
    --filter "name=^/qwen-searxng$" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
  printf '\nGPU processes:\n'
  nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader 2>/dev/null || true
}

logs() {
  journalctl --user -u "${HARNESS_UNIT}" -n 100 --no-pager
}

usage() {
  cat <<'EOF'
Usage: local-ai COMMAND [OPTIONS] [TARGET ...]

Commands:
  start [--recipe RECIPE] [TARGET ...]
                      Start targets with the selected Qwen recipe
  stop [--recipe RECIPE] [TARGET ...]
                      Stop targets; without --recipe, qwen stops every recipe
  prepare RECIPE      Prepare one Qwen recipe without starting it
  model-start  Load Qwen onto the GPU without starting Harness
  model-stop   Stop Qwen and release its GPU memory
  status       Show Harness, container, and GPU-process status
  logs         Show the last 100 lines of the Harness log

Targets: qwen, harness, searxng, all
Recipes: sglang (default), exl3, ninfer

Examples:
  local-ai start qwen harness
  local-ai start --recipe exl3 qwen harness
  local-ai start --recipe ninfer qwen harness searxng
  local-ai stop qwen
  local-ai prepare ninfer
EOF
}

case "${1:-}" in
  start)
    shift
    parse_service_arguments start "$@"
    start_targets "${SELECTED_RECIPE}" "${PARSED_TARGETS[@]}"
    ;;
  prepare)
    shift
    (( $# == 1 )) || { usage; exit 2; }
    validate_recipe "$1"
    case "$1" in
      sglang) prepare_qwen_sglang ;;
      exl3) prepare_qwen_full ;;
      ninfer) prepare_qwen_ninfer ;;
    esac
    ;;
  model-start) model_start ;;
  model-stop) model_stop ;;
  stop)
    shift
    parse_service_arguments stop "$@"
    stop_targets "${SELECTED_RECIPE}" "${PARSED_TARGETS[@]}"
    ;;
  status) status ;;
  logs) logs ;;
  *) usage; exit 2 ;;
esac
