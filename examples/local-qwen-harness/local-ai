prepare() {
  local recipe="$1"; valid_recipe "$recipe"
  case "$recipe" in
    sglang) compose "$recipe" pull qwen ;;
    exl3) prepare_exl3 ;;
    ninfer|a3b) prepare_ninfer_artifact "$recipe" ;;
    udq4) prepare_udq4 ;;
  esac
  printf '%s is prepared; nothing was started.\n' "$recipe"
}

preflight_memory() {
  local recipe="$1" need="${REQUIRED[$recipe]}" total free
  (( DESKTOP_USE )) && case "$recipe" in exl3) need=27700;; ninfer) need=27620;; udq4|a3b) need=27000;; esac
  (( need == 0 )) && return
  IFS=, read -r total free < <(nvidia-smi --query-gpu=memory.total,memory.free --format=csv,noheader,nounits) ||
    die "Cannot query NVIDIA memory."
  (( free >= need )) || die "$recipe needs about $need MiB free; only $free MiB is free."
}

wait_model() {
  local recipe="$1" i
  printf 'Waiting for %s' "${NAME[$recipe]}"
  for i in {1..450}; do
    curl -fsS --max-time 2 "$API" >/dev/null 2>&1 && { printf '\nReady: %s\n' "$API"; return; }
    running "${CONTAINER[$recipe]}" || { printf '\n'; docker logs --tail 60 "${CONTAINER[$recipe]}" >&2 || true; return 1; }
    (( i % 15 == 0 )) && printf ' %ss' "$((i*2))" || printf '.'
    sleep 2
  done
  die "Startup timed out; run: local-ai logs qwen"
}

start_model() {
  local recipe="$1" other context mmproj=--no-mmproj-offload
  context="${CONTEXT[$recipe]}"; (( DESKTOP_USE )) && context="${DESKTOP[$recipe]}"
  (( DESKTOP_USE )) && mmproj=--mmproj-offload
  for other in "${RECIPES[@]}"; do
    [[ "$other" == "$recipe" ]] || ! running "${CONTAINER[$other]}" ||
      die "${NAME[$other]} is already running; use: local-ai stop qwen"
  done
  if running "${CONTAINER[$recipe]}"; then printf '%s is already running.\n' "${NAME[$recipe]}"; sync_model "$recipe" "$context"; return; fi
  prepare "$recipe"; preflight_memory "$recipe"
  printf 'Starting %s with %s tokens%s.\n' "${NAME[$recipe]}" "$context" "$([[ $DESKTOP_USE == 1 ]] && printf ' (desktop-use)')"
  QWEN_CONTEXT_LENGTH="$context" QWEN_KV_CAPACITY="$context" QWEN_MMPROJ_MODE="$mmproj" compose "$recipe" up -d "${SERVICE[$recipe]}"
  wait_model "$recipe"; sync_model "$recipe" "$context"
}

sync_settings() {
  local file="$1" id="$2" name="$3" context="$4" vision="$5" native="$6" tiers="$7" tmp
  [[ -f "$file" ]] || return
  tmp="$(mktemp "$file.local-ai.XXXXXX")"
  awk -v id="$id" -v name="$name" -v context="$context" -v vision="$vision" -v native="$native" -v tiers="$tiers" '
    function model(){print "      models:"; print "        - id: " id; print "          name: " name;
      print "          contextWindow: " context; print "          input:"; print "            - text";
      if(vision) print "            - image";
      if(tiers){print "          reasoningEfforts:"; print "            off: " (native ? "none" : "");
        print "            low: low"; print "            medium: medium"; print "            xhigh: xhigh";
        print "          compat:"; print "            supportsDeveloperRole: false";
      if(native){print "            supportsReasoningEffort: true"; print "            thinkingFormat: openai"}
      else{print "            thinkingFormat: chat-template"; print "            chatTemplateKwargs:";
        print "              enable_thinking: {\"$var\": thinking.enabled}";
        print "              reasoning_effort: {\"$var\": thinking.effort, omitWhenOff: true}";
        print "              preserve_thinking: true"}}}
    {s=$0; sub(/^[[:space:]]*/, "", s)
     if(!done && $0=="      models:"){model(); done=1; skip=1; next}
     if(skip){if($0=="agent-default-model:"){skip=0; def=1; print}; next}
     if($0=="agent-default-model:") def=1
     if(def && s~/^model:[[:space:]]*/){match($0,/^[[:space:]]*/); print substr($0,1,RLENGTH) "model: " id; set=1; next}
     if(def && !tiers && s~/^reasoningEffort:[[:space:]]*/) next
     print} END{if(done!=1 || set!=1) exit 42}' "$file" >"$tmp" ||
    { rm -f "$tmp"; die "Could not update $file; run ./bootstrap.sh"; }
  chmod --reference="$file" "$tmp" 2>/dev/null || chmod 600 "$tmp"; mv "$tmp" "$file"
}

sync_model() {
  local recipe="$1" context="${2:-${CONTEXT[$1]}}" native=0 tiers=1
  [[ "$recipe" == ninfer || "$recipe" == a3b ]] && native=1
  [[ "$recipe" == a3b ]] && tiers=0
  sync_settings "$DSH_DIR/settings.yaml" "${MODEL[$recipe]}" "${NAME[$recipe]}" "$context" "${VISION[$recipe]}" "$native" "$tiers"
  sync_settings "$WORK_DSH_DIR/settings.yaml" "${MODEL[$recipe]}" "${NAME[$recipe]}" "$context" "${VISION[$recipe]}" "$native" "$tiers"
}

sync_from_api() {
  local id context recipe
  read -r id context < <(curl -fsS --max-time 2 "$API" | python3 -c 'import json,sys;m=json.load(sys.stdin)["data"][0];print(m["id"],m.get("max_model_len",""))' 2>/dev/null) || return 0
  for recipe in "${RECIPES[@]}"; do [[ "$id" == "${MODEL[$recipe]}" ]] && { sync_model "$recipe" "$context"; return; }; done
}

harness() {
  local action="$1" home unit url port workspace
  if (( WORK_MODE )); then home="$WORK_DSH_DIR"; unit=local-qwen-harness-work.service; url=http://127.0.0.1:3081; workspace="${LOCAL_AI_WORKSPACE:-$PWD}"
  else home="$DSH_DIR"; unit=local-qwen-harness.service; url=http://127.0.0.1:3080; workspace="$HOME"; fi
  port="${url##*:}"
  if [[ "$action" == stop ]]; then
    systemctl --user is-active --quiet "$unit" && systemctl --user stop "$unit" || true
    printf 'Harness stopped: %s\n' "$url"; return
  fi
  systemctl --user is-active --quiet "$unit" && { printf 'Harness already running: %s\n' "$url"; return; }
  sync_from_api; systemctl --user reset-failed "$unit" >/dev/null 2>&1 || true
  systemd-run --user --quiet --collect --unit="$unit" --property=Type=exec \
    --property=KillMode=control-group --property=TimeoutStopSec=15 --working-directory="$workspace" \
    --setenv="DSH_HOME=$home" --setenv="QWEN_LOCAL_API_KEY=${QWEN_LOCAL_API_KEY:-local-no-key}" \
    "$(command -v pnpm)" dlx "$DSH_PACKAGE" web --port "$port" --no-open
  for _ in {1..30}; do curl -fsS --max-time 2 "$url" >/dev/null 2>&1 && { printf 'Harness ready: %s\n' "$url"; return; }; sleep 1; done
  journalctl --user -u "$unit" -n 40 --no-pager >&2 || true; return 1
}

stop_models() {
  local recipe
  for recipe in "${RECIPES[@]}"; do
    [[ -z "$SELECTED_RECIPE" || "$recipe" == "$SELECTED_RECIPE" ]] || continue
    running "${CONTAINER[$recipe]}" && docker stop --timeout 60 "${CONTAINER[$recipe]}" >/dev/null
  done
  printf 'Selected Qwen model allocations released.\n'
  return 0
}

service_targets() {
  local action="$1" recipe="$2"
  if [[ "$action" == start ]]; then
    requested searxng && docker compose -f "$STACK/compose.yaml" up -d searxng
    requested qwen && start_model "$recipe"
    requested harness && harness start
  else
    requested harness && harness stop
    requested qwen && stop_models
    requested searxng && { docker compose -f "$STACK/compose.yaml" stop searxng >/dev/null; printf 'SearXNG stopped.\n'; }
  fi
  return 0
}

status() {
  local unit url
  for unit in local-qwen-harness.service local-qwen-harness-work.service; do
    [[ "$unit" == *-work.* ]] && url=http://127.0.0.1:3081 || url=http://127.0.0.1:3080
    printf '%-13s %s\n' "${unit#local-qwen-}" "$(systemctl --user is-active "$unit" 2>/dev/null || true)  $url"
  done
  docker ps -a --filter name=qwen --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
  printf '\nGPU:\n'; nvidia-smi --query-gpu=name,memory.used,memory.free,utilization.gpu,temperature.gpu --format=csv,noheader 2>/dev/null || true
}

logs() {
  local target="${1:-harness}" recipe
  case "$target" in
    harness) (( WORK_MODE )) && journalctl --user -u local-qwen-harness-work.service -n 100 --no-pager ||
      journalctl --user -u local-qwen-harness.service -n 100 --no-pager ;;
    searxng) docker logs --tail 100 qwen-searxng ;;
    qwen) for recipe in "${RECIPES[@]}"; do running "${CONTAINER[$recipe]}" && { docker logs --tail 100 "${CONTAINER[$recipe]}"; return; }; done; die "No model is running." ;;
    *) die "Log target must be qwen, harness, or searxng." ;;
  esac
}

show_recipes() {
  local r mark vision
  printf 'MODEL ARTIFACTS\n+---------+------------------+-----------+---------------+-----------+\n'
  printf '| %-7s | %-16s | %-9s | %-13s | %-9s |\n' RECIPE 'BASE MODEL' ENGINE QUANTIZATION SOURCE
  printf '+---------+------------------+-----------+---------------+-----------+\n'
  for r in "${RECIPES[@]}"; do
    mark="$r"; [[ "$r" == sglang ]] && mark+='*'
    printf '| %-7s | %-16s | %-9s | %-13s | %-9s |\n' "$mark" "${BASE[$r]}" "${ENGINE[$r]}" "${WEIGHTS[$r]}" "${SOURCE[$r]}"
  done
  printf '+---------+------------------+-----------+---------------+-----------+\n\n'
  printf 'RUNTIME PROFILES\n+---------+------+---------+---------+--------+----------------------+---------+\n'
  printf '| %-7s | %-4s | %7s | %7s | %-6s | %-20s | %-7s |\n' RECIPE KV MAX DESKTOP VISION REASONING DRAFT
  printf '+---------+------+---------+---------+--------+----------------------+---------+\n'
  for r in "${RECIPES[@]}"; do
    mark="$r"; [[ "$r" == sglang ]] && mark+='*'; vision=no; [[ "${VISION[$r]}" == 1 ]] && vision=yes
    printf '| %-7s | %-4s | %7s | %7s | %-6s | %-20s | %-7s |\n' "$mark" "${KV[$r]}" "${CONTEXT[$r]}" "${DESKTOP[$r]}" "$vision" "${REASON[$r]}" "${SPEC[$r]}"
  done
  printf '+---------+------+---------+---------+--------+----------------------+---------+\n\n'
  printf 'All recipes use http://127.0.0.1:30000/v1; * is the default.\n'
}

github() {
  command -v gh >/dev/null || die "Install GitHub CLI first."
  if [[ "$1" == login ]]; then GH_CONFIG_DIR="$GH_DIR" gh auth login -h github.com --web --scopes repo,read:org
  else GH_CONFIG_DIR="$GH_DIR" gh auth status -h github.com; fi
}

usage() { cat <<'EOF'
local-ai — manage the local Qwen stack

USAGE
  local-ai start [--work] [--recipe NAME] [--desktop-use] [TARGET ...]
  local-ai stop  [--work] [--recipe NAME] [TARGET ...]
  local-ai prepare NAME
  local-ai COMMAND

COMMANDS
  start           Start targets; default: all
  stop            Stop targets; default: all
  prepare         Download/build one recipe without starting it
  recipes         List model recipes
  dashboard       Interactive status, logs, and GPU metrics
  status          Compact service/container/GPU status
  logs            Last 100 lines for qwen, harness, or searxng
  github-login    Sign the isolated work profile into GitHub
  github-status   Check its GitHub login
  test            Run repository checks

OPTIONS
  --recipe NAME   sglang (default), exl3, ninfer, udq4, or a3b
  --desktop-use   Use the recipe's desktop context profile
  --work          Use isolated Harness at :3081 in the current directory

TARGETS
  qwen            OpenAI-compatible model server at :30000/v1
  harness         Personal Harness (:3080), or work Harness with --work
  searxng         Private search service at :8888
  all             All targets (default)

EXAMPLES
  local-ai start qwen harness
  local-ai start --recipe udq4 --desktop-use qwen harness
  local-ai start --work --recipe a3b qwen harness searxng
  local-ai stop qwen
  local-ai recipes
EOF
}

SELECTED_RECIPE=""; DESKTOP_USE=0; WORK_MODE=0; TARGETS=()
parse() {
  local mode="$1"; shift
  while (( $# )); do case "$1" in
    --recipe) shift; (( $# )) || die "--recipe needs a value"; SELECTED_RECIPE="$1" ;;
    --recipe=*) SELECTED_RECIPE="${1#*=}" ;;
    --desktop-use) [[ "$mode" == start ]] || die "--desktop-use is start-only"; DESKTOP_USE=1 ;;
    --work) WORK_MODE=1 ;;
    --*) die "Unknown option: $1" ;;
    *) TARGETS+=("$1") ;;
  esac; shift; done
  [[ -n "$SELECTED_RECIPE" ]] && valid_recipe "$SELECTED_RECIPE"
  [[ "$mode" == start && -z "$SELECTED_RECIPE" ]] && SELECTED_RECIPE=sglang
  (( ${#TARGETS[@]} )) || TARGETS=(all)
  local t; for t in "${TARGETS[@]}"; do [[ "$t" =~ ^(qwen|harness|searxng|all)$ ]] || die "Unknown target: $t"; done
}

case "${1:-}" in
  start|stop) command="$1"; shift; parse "$command" "$@"; service_targets "$command" "$SELECTED_RECIPE" ;;
  prepare) shift; (( $# == 1 )) || die "Usage: local-ai prepare RECIPE"; prepare "$1" ;;
  recipes) show_recipes ;;
  dashboard) exec python3 "$STACK/dashboard.py" ;;
  status) status ;;
  logs) shift; [[ "${1:-}" == --work ]] && { WORK_MODE=1; shift; }; (( $# <= 1 )) || die "Usage: local-ai logs [--work] [TARGET]"; logs "${1:-}" ;;
  github-login) github login ;;
  github-status) github status ;;
  test) exec "$STACK/test.sh" ;;
  help|-h|--help) usage ;;
  "") usage; exit 2 ;;
  *) die "Unknown command: $1" ;;
esac
