#!/usr/bin/env bash
set -euo pipefail
umask 077

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
STACK_DIR="$(cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd)"
QWEN_CONTAINER="qwen38"
QWEN_URL="http://127.0.0.1:30000/v1/models"
QWEN_FULL_CONTAINER="qwen38-full"
QWEN_FULL_URL="http://127.0.0.1:30000/v1/models"
QWEN_FULL_PATCH_COMMIT="8558b8ca3bba028f852f4b53167b79b4cd552f93"
QWEN_FULL_PATCH_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/local-qwen-harness/qwen38-exl3-${QWEN_FULL_PATCH_COMMIT:0:12}"
QWEN_FULL_PATCH_BASE="https://raw.githubusercontent.com/malaiwah/qwen38-27b-exl3/${QWEN_FULL_PATCH_COMMIT}/tools"
QWEN_NINFER_CONTAINER="qwen38-ninfer"
QWEN_NINFER_URL="http://127.0.0.1:30000/v1/models"
QWEN_NINFER_SOURCE_COMMIT="a140e7ae82a11ed2f370a4d8f2cc16268a3790b8"
QWEN_NINFER_SOURCE_URL="https://github.com/Neroued/ninfer.git"
QWEN_NINFER_SOURCE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/local-qwen-harness/ninfer-${QWEN_NINFER_SOURCE_COMMIT:0:12}"
QWEN_NINFER_IMAGE="local/qwen-ninfer:${QWEN_NINFER_SOURCE_COMMIT:0:12}"
QWEN_NINFER_MODEL_REVISION="204e3d92c30d9d05f3300d2f52e443ad1edf6ddf"
QWEN_NINFER_MODEL_SHA256="bb3360522a06e136e0367f5703414d26272b7285c8a6ab6194135c17dbd81b32"
QWEN_NINFER_MODEL_SIZE="21492695040"
QWEN_NINFER_MODEL_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/local-qwen-harness/ninfer-model-${QWEN_NINFER_MODEL_REVISION:0:12}"
QWEN_NINFER_MODEL_FILE="${QWEN_NINFER_MODEL_DIR}/qwen3_8_27b_nvfp4.ninfer"
QWEN_NINFER_MODEL_URL="https://huggingface.co/neroued/Qwen3.8-27B-nvfp4-NInfer/resolve/${QWEN_NINFER_MODEL_REVISION}/qwen3_8_27b_nvfp4.ninfer?download=true"
HARNESS_URL="http://127.0.0.1:3080"
WORK_HARNESS_URL="http://127.0.0.1:3081"
DSH_PACKAGE="@deepseek-ai/dsh@0.1.1-rc.2"
HARNESS_UNIT="local-qwen-harness.service"
WORK_HARNESS_UNIT="local-qwen-harness-work.service"
DSH_DIR="${DSH_DIR:-${HOME}/.dsh}"
WORK_DSH_DIR="${WORK_DSH_DIR:-${HOME}/.dsh-work}"
HARNESS_SETTINGS="${DSH_DIR}/settings.yaml"
WORK_HARNESS_SETTINGS="${WORK_DSH_DIR}/settings.yaml"
WORK_GH_CONFIG_DIR="${GITHUB_WORK_GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/gh-work}"

start_qwen() {
  if container_running "${QWEN_FULL_CONTAINER}" || container_running "${QWEN_NINFER_CONTAINER}"; then
    printf 'Another Qwen recipe is already using the GPU. Run: local-ai stop qwen\n' >&2
    return 1
  fi
  if (( DESKTOP_USE )); then
    printf 'SGLang is already desktop-qualified; keeping its normal 122,880-token profile.\n'
  fi
  docker compose -f "${STACK_DIR}/qwen-sglang-nvfp4-122880.compose.yaml" up -d qwen
}

container_running() {
  [[ "$(docker container inspect --format '{{.State.Running}}' "$1" 2>/dev/null || true)" == "true" ]]
}

wait_for_model() {
  local label="$1"
  local url="$2"
  local attempts="$3"
  local container_name="$4"

  printf 'Waiting for %s to become ready' "${label}"
  for _ in $(seq 1 "${attempts}"); do
    if curl -fsS --max-time 2 "${url}" >/dev/null 2>&1; then
      printf '\n%s is ready: %s\n' "${label}" "${url}"
      return 0
    fi
    if ! container_running "${container_name}"; then
      printf '\n%s stopped before becoming ready. Recent container log:\n' "${label}" >&2
      docker logs --tail 40 "${container_name}" >&2 || true
      return 1
    fi
    printf '.'
    sleep 2
  done
  printf '\n%s did not become ready. Inspect: docker logs %s\n' \
    "${label}" "${container_name}" >&2
  return 1
}

wait_for_qwen() {
  wait_for_model "Qwen" "${QWEN_URL}" 180 "${QWEN_CONTAINER}"
}

verify_full_patches() {
  local patch_root="$1"
  local failed=0

  printf '%s  %s\n' \
    2df9d0799fd323798cead1edb773cab556c94798eec263ee03ded35408c6e4ee \
    "${patch_root}/tools/vllm-exl3-prefill-dispatch.py" | sha256sum -c - >/dev/null || failed=1
  printf '%s  %s\n' \
    04d2bd587b37142f4f55a8d00b9f8c907309490168cb7fcdfde450531df2c9e7 \
    "${patch_root}/tools/vllm-qwen3_5-embed-quant-config.py" | sha256sum -c - >/dev/null || failed=1
  printf '%s  %s\n' \
    0090dc131f0eaf439b24d50baf4def9f10b052864c76e695053d64f66b274bab \
    "${patch_root}/tools/vllm-qwen3_5_mtp-embed-quant-config.py" | sha256sum -c - >/dev/null || failed=1
  printf '%s  %s\n' \
    b431c1066dfee3ed56bfa7e71cc8606f9afadc300f22d7fc542c43835d1b22bf \
    "${patch_root}/tools/vllm-mamba-align-scheduler.py" | sha256sum -c - >/dev/null || failed=1
  return "${failed}"
}

ensure_full_patches() {
  local temp_dir
  local filename

  if verify_full_patches "${QWEN_FULL_PATCH_DIR}" 2>/dev/null; then
    return 0
  fi
  if [[ -e "${QWEN_FULL_PATCH_DIR}" ]]; then
    printf 'Existing full-context patch cache failed verification: %s\n' "${QWEN_FULL_PATCH_DIR}" >&2
    printf 'Move it aside, then run: local-ai prepare exl3\n' >&2
    return 1
  fi

  mkdir -p "$(dirname -- "${QWEN_FULL_PATCH_DIR}")"
  temp_dir="$(mktemp -d "$(dirname -- "${QWEN_FULL_PATCH_DIR}")/.qwen-full-patches.XXXXXX")"
  mkdir -p "${temp_dir}/tools"
  for filename in \
    vllm-exl3-prefill-dispatch.py \
    vllm-qwen3_5-embed-quant-config.py \
    vllm-qwen3_5_mtp-embed-quant-config.py \
    vllm-mamba-align-scheduler.py; do
    if ! curl -fL --retry 3 --output "${temp_dir}/tools/${filename}" \
      "${QWEN_FULL_PATCH_BASE}/${filename}"; then
      rm -rf -- "${temp_dir}"
      return 1
    fi
  done
  if ! verify_full_patches "${temp_dir}"; then
    rm -rf -- "${temp_dir}"
    printf 'Downloaded full-context patches failed checksum verification.\n' >&2
    return 1
  fi
  mv -- "${temp_dir}" "${QWEN_FULL_PATCH_DIR}"
  printf 'Verified full-context runtime overlays at %s\n' "${QWEN_FULL_PATCH_DIR}"
}

full_compose() {
  QWEN_FULL_PATCH_DIR="${QWEN_FULL_PATCH_DIR}" \
    docker compose -f "${STACK_DIR}/qwen-vllm-exl3-k5k6-262144.compose.yaml" "$@"
}

ensure_full_image() {
  full_compose pull --policy missing qwen-full
}

prepare_qwen_full() {
  ensure_full_patches
  docker volume inspect qwen38-full-hf-cache >/dev/null 2>&1 || \
    docker volume create qwen38-full-hf-cache >/dev/null
  ensure_full_image
  printf 'exl3 recipe is prepared. Model weights download on first start.\n'
}

check_qwen_full_memory() {
  local total_mib
  local free_mib
  local required_mib

  if ! IFS=, read -r total_mib free_mib < <(
    nvidia-smi --query-gpu=memory.total,memory.free --format=csv,noheader,nounits 2>/dev/null
  ); then
    printf 'Cannot query the NVIDIA GPU; qwen-full startup was not attempted.\n' >&2
    return 1
  fi
  if (( DESKTOP_USE )); then
    required_mib=$((total_mib * 850 / 1000))
  else
    required_mib=$((total_mib * 955 / 1000))
  fi
  if (( free_mib < required_mib )); then
    printf 'exl3 needs about %s MiB free for the selected memory profile; only %s MiB is free.\n' \
      "${required_mib}" "${free_mib}" >&2
    printf 'Close GPU applications and stop the graphical session before retrying; startup was not attempted.\n' >&2
    return 1
  fi
}

start_qwen_full() {
  if container_running "${QWEN_CONTAINER}" || container_running "${QWEN_NINFER_CONTAINER}"; then
    printf 'Another Qwen recipe is already using the GPU. Run: local-ai stop qwen\n' >&2
    return 1
  fi
  ensure_full_patches
  ensure_full_image
  check_qwen_full_memory
  if (( DESKTOP_USE )); then
    printf 'Desktop-use profile: exl3, 155,648 context, about 4.9-GiB total VRAM reserve.\n'
    QWEN_FULL_PATCH_DIR="${QWEN_FULL_PATCH_DIR}" \
    QWEN_CONTEXT_LENGTH=155648 \
    QWEN_PREFILL_CHUNK=1024 \
    QWEN_GPU_MEMORY_UTILIZATION=0.85 \
    QWEN_MAX_PIXELS=4194304 \
      docker compose -f "${STACK_DIR}/qwen-vllm-exl3-k5k6-262144.compose.yaml" up -d qwen-full
  else
    full_compose up -d qwen-full
  fi
  wait_for_model "Qwen vLLM/EXL3" "${QWEN_FULL_URL}" 450 "${QWEN_FULL_CONTAINER}"
}

ensure_ninfer_source() {
  local temp_dir
  local source_head
  local source_status

  if [[ -d "${QWEN_NINFER_SOURCE_DIR}/.git" ]]; then
    source_head="$(git -C "${QWEN_NINFER_SOURCE_DIR}" rev-parse HEAD 2>/dev/null || true)"
    source_status="$(git -C "${QWEN_NINFER_SOURCE_DIR}" status --porcelain --untracked-files=normal 2>/dev/null || true)"
    if [[ "${source_head}" == "${QWEN_NINFER_SOURCE_COMMIT}" && -z "${source_status}" ]]; then
      return 0
    fi
    printf 'Existing NInfer source cache is modified or not at the pinned revision: %s\n' \
      "${QWEN_NINFER_SOURCE_DIR}" >&2
    printf 'Move it aside, then run: local-ai prepare ninfer\n' >&2
    return 1
  fi
  if [[ -e "${QWEN_NINFER_SOURCE_DIR}" ]]; then
    printf 'NInfer source cache path exists but is not a Git checkout: %s\n' \
      "${QWEN_NINFER_SOURCE_DIR}" >&2
    return 1
  fi

  mkdir -p "$(dirname -- "${QWEN_NINFER_SOURCE_DIR}")"
  temp_dir="$(mktemp -d "$(dirname -- "${QWEN_NINFER_SOURCE_DIR}")/.ninfer-source.XXXXXX")"
  if ! git clone --filter=blob:none --no-checkout \
    "${QWEN_NINFER_SOURCE_URL}" "${temp_dir}/source"; then
    rm -rf -- "${temp_dir}"
    return 1
  fi
  if ! git -C "${temp_dir}/source" checkout --detach "${QWEN_NINFER_SOURCE_COMMIT}"; then
    rm -rf -- "${temp_dir}"
    return 1
  fi
  mv -- "${temp_dir}/source" "${QWEN_NINFER_SOURCE_DIR}"
  rmdir -- "${temp_dir}"
  printf 'Pinned NInfer source at %s\n' "${QWEN_NINFER_SOURCE_DIR}"
}

verify_ninfer_model() {
  [[ -f "${QWEN_NINFER_MODEL_FILE}" ]] || return 1
  [[ "$(stat -c '%s' "${QWEN_NINFER_MODEL_FILE}")" == "${QWEN_NINFER_MODEL_SIZE}" ]] || return 1
  printf '%s  %s\n' "${QWEN_NINFER_MODEL_SHA256}" "${QWEN_NINFER_MODEL_FILE}" | \
    sha256sum -c - >/dev/null
}

ensure_ninfer_model() {
  local current_size=0

  if verify_ninfer_model; then
    return 0
  fi
  if [[ -f "${QWEN_NINFER_MODEL_FILE}" ]]; then
    current_size="$(stat -c '%s' "${QWEN_NINFER_MODEL_FILE}")"
    if (( current_size >= QWEN_NINFER_MODEL_SIZE )); then
      printf 'Existing NInfer artifact failed size or checksum verification: %s\n' \
        "${QWEN_NINFER_MODEL_FILE}" >&2
      printf 'Move it aside, then run: local-ai prepare ninfer\n' >&2
      return 1
    fi
    printf 'Resuming NInfer model download at %s of %s bytes.\n' \
      "${current_size}" "${QWEN_NINFER_MODEL_SIZE}"
  fi

  mkdir -p "${QWEN_NINFER_MODEL_DIR}"
  if command -v aria2c >/dev/null 2>&1; then
    aria2c --continue=true --auto-file-renaming=false --file-allocation=none \
      --max-connection-per-server=4 --split=4 \
      --dir="${QWEN_NINFER_MODEL_DIR}" --out="$(basename -- "${QWEN_NINFER_MODEL_FILE}")" \
      "${QWEN_NINFER_MODEL_URL}"
  else
    curl -fL --retry 3 --continue-at - --output "${QWEN_NINFER_MODEL_FILE}" \
      "${QWEN_NINFER_MODEL_URL}"
  fi
  if ! verify_ninfer_model; then
    printf 'Downloaded NInfer artifact failed size or checksum verification: %s\n' \
      "${QWEN_NINFER_MODEL_FILE}" >&2
    return 1
  fi
  printf 'Verified NInfer model artifact at %s\n' "${QWEN_NINFER_MODEL_FILE}"
}

ensure_ninfer_image() {
  local image_revision

  image_revision="$(docker image inspect --format \
    '{{ index .Config.Labels "org.opencontainers.image.revision" }}' \
    "${QWEN_NINFER_IMAGE}" 2>/dev/null || true)"
  if [[ "${image_revision}" == "${QWEN_NINFER_SOURCE_COMMIT}" ]]; then
    return 0
  fi
  ensure_ninfer_source
  docker build \
    --build-arg "NINFER_SOURCE_REVISION=${QWEN_NINFER_SOURCE_COMMIT}" \
    --file "${STACK_DIR}/ninfer.Dockerfile" \
    --tag "${QWEN_NINFER_IMAGE}" \
    "${QWEN_NINFER_SOURCE_DIR}"
}

ninfer_compose() {
  QWEN_NINFER_MODEL_FILE="${QWEN_NINFER_MODEL_FILE}" \
    docker compose -f "${STACK_DIR}/qwen-ninfer-nvfp4-252928.compose.yaml" "$@"
}

prepare_qwen_ninfer() {
  ensure_ninfer_source
  ensure_ninfer_image
  ensure_ninfer_model
  printf 'ninfer recipe is prepared. Nothing was started.\n'
}

check_qwen_ninfer_memory() {
  local total_mib
  local free_mib
  local required_mib

  if ! IFS=, read -r total_mib free_mib < <(
    nvidia-smi --query-gpu=memory.total,memory.free --format=csv,noheader,nounits 2>/dev/null
  ); then
    printf 'Cannot query the NVIDIA GPU; qwen-ninfer startup was not attempted.\n' >&2
    return 1
  fi
  if (( DESKTOP_USE )); then
    required_mib=27620
  else
    required_mib=$((total_mib - 1080))
  fi
  if (( free_mib < required_mib )); then
    printf 'ninfer needs approximately %s MiB free for the selected memory profile; only %s MiB is free.\n' \
      "${required_mib}" "${free_mib}" >&2
    printf 'Close GPU applications and stop the graphical session before retrying; startup was not attempted.\n' >&2
    return 1
  fi
}

start_qwen_ninfer() {
  if container_running "${QWEN_CONTAINER}" || container_running "${QWEN_FULL_CONTAINER}"; then
    printf 'Another Qwen recipe is already using the GPU. Run: local-ai stop qwen\n' >&2
    return 1
  fi
  ensure_ninfer_source
  ensure_ninfer_image
  ensure_ninfer_model
  check_qwen_ninfer_memory
  if (( DESKTOP_USE )); then
    printf 'Desktop-use profile: ninfer, 172,032 context, about 5.0-GiB total VRAM reserve.\n'
    QWEN_NINFER_MODEL_FILE="${QWEN_NINFER_MODEL_FILE}" \
    QWEN_CONTEXT_LENGTH=172032 \
    QWEN_KV_CAPACITY=172032 \
    QWEN_MAX_CONCURRENCY=1 \
    QWEN_PREFILL_CHUNK=512 \
      docker compose -f "${STACK_DIR}/qwen-ninfer-nvfp4-252928.compose.yaml" up -d qwen-ninfer
  else
    ninfer_compose up -d qwen-ninfer
  fi
  wait_for_model "Qwen NInfer" "${QWEN_NINFER_URL}" 450 "${QWEN_NINFER_CONTAINER}"
}

prepare_qwen_sglang() {
  docker volume inspect qwen38-hf-cache >/dev/null 2>&1 || \
    docker volume create qwen38-hf-cache >/dev/null
  docker compose -f "${STACK_DIR}/qwen-sglang-nvfp4-122880.compose.yaml" pull qwen
  printf 'sglang recipe is prepared. Nothing was started.\n'
}

start_harness_service() {
  local label="$1" url="$2" unit="$3" dsh_home="$4" workspace="$5"
  local pnpm_bin port="${url##*:}"

  if systemctl --user is-active --quiet "${unit}"; then
    printf '%s is already running: %s\n' "${label}" "${url}"
    return 0
  fi

  if curl -fsS --max-time 2 "${url}" >/dev/null 2>&1; then
    printf 'Port %s already has an unmanaged listener; refusing to start a duplicate.\n' "${port}" >&2
    return 1
  fi

  pnpm_bin="$(command -v pnpm)"
  sync_harness_from_api || true
  systemctl --user reset-failed "${unit}" >/dev/null 2>&1 || true
  printf 'Starting %s in the background: %s\n' "${label}" "${url}"
  systemd-run --user --quiet --collect \
    --unit="${unit}" \
    --property=Type=exec \
    --property=KillMode=control-group \
    --property=TimeoutStopSec=15 \
    --working-directory="${workspace}" \
    --setenv="DSH_HOME=${dsh_home}" \
    --setenv="QWEN_LOCAL_API_KEY=${QWEN_LOCAL_API_KEY:-local-no-key}" \
    "${pnpm_bin}" dlx "${DSH_PACKAGE}" web --port "${port}" --no-open

  for _ in $(seq 1 30); do
    if ! systemctl --user is-active --quiet "${unit}"; then
      printf '%s exited during startup. Recent log output:\n' "${label}" >&2
      journalctl --user -u "${unit}" -n 40 --no-pager >&2 || true
      return 1
    fi
    if curl -fsS --max-time 2 "${url}" >/dev/null 2>&1; then
      printf '%s is ready.\n' "${label}"
      return 0
    fi
    sleep 1
  done

  printf '%s did not become ready within 30 seconds.\n' "${label}" >&2
  return 1
}

start_harness() {
  start_harness_service "Harness" "${HARNESS_URL}" "${HARNESS_UNIT}" "${DSH_DIR}" "${HOME}"
}

start_work_harness() {
  start_harness_service "Work Harness" "${WORK_HARNESS_URL}" "${WORK_HARNESS_UNIT}" \
    "${WORK_DSH_DIR}" "${LOCAL_AI_WORKSPACE:-${PWD}}"
}

sync_harness_model() {
  local recipe="$1"
  local active_context="${2:-}"
  local active_id
  local active_name
  local active_vision
  local settings_file

  case "${recipe}" in
    sglang)
      active_id='qwen3.8-27b-sglang-nvfp4-122880'
      active_name='Qwen 3.8 27B · SGLang · NVFP4 · 122,880'
      active_context="${active_context:-122880}"
      active_vision=1
      ;;
    exl3)
      active_id='qwen3.8-27b-vllm-exl3-k5k6-262144'
      active_name='Qwen 3.8 27B · vLLM · EXL3 K5/K6 · 262,144'
      active_context="${active_context:-$(( DESKTOP_USE ? 155648 : 262144 ))}"
      active_vision=1
      ;;
    ninfer)
      active_id='qwen3.8-27b-ninfer-nvfp4-252928'
      active_name='Qwen 3.8 27B · NInfer · NVFP4 · 252,928'
      active_context="${active_context:-$(( DESKTOP_USE ? 172032 : 252928 ))}"
      active_vision=0
      ;;
  esac

  for settings_file in "${HARNESS_SETTINGS}" "${WORK_HARNESS_SETTINGS}"; do
    [[ -f "${settings_file}" ]] || continue
    sync_harness_settings "${settings_file}" "${active_id}" "${active_name}" \
      "${active_context}" "${active_vision}"
  done
  printf 'Harness catalogs synchronized for %s only (%s tokens).\n' \
    "${recipe}" "${active_context}"
}

sync_harness_from_api() {
  local model_id context recipe
  read -r model_id context < <(
    curl -fsS --max-time 2 "${QWEN_URL}" 2>/dev/null | python3 -c \
      'import json,sys; m=json.load(sys.stdin)["data"][0]; print(m["id"], m.get("max_model_len", ""))' 2>/dev/null
  ) || return 0
  case "${model_id}" in
    *-sglang-*) recipe=sglang ;;
    *-vllm-exl3-*) recipe=exl3 ;;
    *-ninfer-*) recipe=ninfer ;;
    *) return 0 ;;
  esac
  [[ "${context}" =~ ^[0-9]+$ ]] || context=""
  sync_harness_model "${recipe}" "${context}"
}

sync_harness_settings() {
  local settings_file="$1" active_id="$2" active_name="$3" active_context="$4" active_vision="$5"
  local temp_settings

  temp_settings="$(mktemp "${settings_file}.local-ai.XXXXXX")"
  if ! awk \
    -v active_id="${active_id}" \
    -v active_name="${active_name}" \
    -v active_context="${active_context}" \
    -v active_vision="${active_vision}" '
      function print_model() {
        print "      models:"
        print "        - id: " active_id
        print "          name: " active_name
        print "          contextWindow: " active_context
        print "          input:"
        print "            - text"
        if (active_vision) print "            - image"
      }
      {
        stripped = $0
        sub(/^[[:space:]]*/, "", stripped)

        if (!models_done && $0 == "      models:") {
          print_model()
          models_done++
          skipping_models = 1
          next
        }
        if (skipping_models) {
          if ($0 == "agent-default-model:") {
            skipping_models = 0
            in_default = 1
            print
          }
          next
        }
        if ($0 == "agent-default-model:") in_default = 1
        if (in_default && stripped ~ /^model:[[:space:]]*/) {
          match($0, /^[[:space:]]*/)
          print substr($0, 1, RLENGTH) "model: " active_id
          default_done++
          in_default = 0
          next
        }
        print
      }
      END {
        if (models_done != 1 || default_done != 1) exit 42
      }
    ' "${settings_file}" >"${temp_settings}"; then
    rm -f -- "${temp_settings}"
    printf 'Could not safely update the Harness model catalog in %s; run ./bootstrap.sh.\n' \
      "${settings_file}" >&2
    return 1
  fi
  chmod --reference="${settings_file}" "${temp_settings}" 2>/dev/null || chmod 0600 "${temp_settings}"
  mv -- "${temp_settings}" "${settings_file}"
}

stop_harness_service() {
  local label="$1" url="$2" unit="$3"
  if ! systemctl --user is-active --quiet "${unit}"; then
    if curl -fsS --max-time 2 "${url}" >/dev/null 2>&1; then
      printf '%s is running but is not managed by this helper; leaving it untouched.\n' "${label}" >&2
      return 1
    fi
    printf '%s is already stopped.\n' "${label}"
    return 0
  fi

  systemctl --user stop "${unit}"
  printf '%s stopped.\n' "${label}"
}

stop_harness() { stop_harness_service "Harness" "${HARNESS_URL}" "${HARNESS_UNIT}"; }
stop_work_harness() { stop_harness_service "Work Harness" "${WORK_HARNESS_URL}" "${WORK_HARNESS_UNIT}"; }

validate_targets() {
  local target_name

  for target_name in "$@"; do
    case "${target_name}" in
      qwen|harness|searxng|all) ;;
      *)
        printf 'Unknown target: %s (expected qwen, harness, searxng, or all)\n' "${target_name}" >&2
        return 2
        ;;
    esac
  done
}

target_requested() {
  local requested_target="$1"
  local target_name
  shift

  for target_name in "$@"; do
    if [[ "${target_name}" == "${requested_target}" || "${target_name}" == "all" ]]; then
      return 0
    fi
  done
  return 1
}

validate_recipe() {
  case "$1" in
    sglang|exl3|ninfer) ;;
    *)
      printf 'Unknown Qwen recipe: %s (expected sglang, exl3, or ninfer)\n' "$1" >&2
      return 2
      ;;
  esac
}

SELECTED_RECIPE=""
DESKTOP_USE=0
WORK_MODE=0
PARSED_TARGETS=()

parse_service_arguments() {
  local mode="$1"
  shift

  SELECTED_RECIPE=""
  DESKTOP_USE=0
  WORK_MODE=0
  PARSED_TARGETS=()
  while (( $# > 0 )); do
    case "$1" in
      --recipe)
        shift
        if (( $# == 0 )); then
          printf '%s requires a value: sglang, exl3, or ninfer\n' --recipe >&2
          return 2
        fi
        SELECTED_RECIPE="$1"
        ;;
      --recipe=*)
        SELECTED_RECIPE="${1#--recipe=}"
        ;;
      --desktop-use)
        if [[ "${mode}" != "start" ]]; then
          printf '%s is valid only with the start command.\n' --desktop-use >&2
          return 2
        fi
        DESKTOP_USE=1
        ;;
      --work)
        WORK_MODE=1
        ;;
      --*)
        printf 'Unknown option: %s\n' "$1" >&2
        return 2
        ;;
      *)
        PARSED_TARGETS+=("$1")
        ;;
    esac
    shift
  done

  if [[ -n "${SELECTED_RECIPE}" ]]; then
    validate_recipe "${SELECTED_RECIPE}"
  elif [[ "${mode}" == "start" ]]; then
    SELECTED_RECIPE="sglang"
  fi
  if (( ${#PARSED_TARGETS[@]} == 0 )); then
    PARSED_TARGETS=(all)
  fi
  validate_targets "${PARSED_TARGETS[@]}"
}

start_targets() {
  local recipe="$1"
  shift

  validate_targets "$@"
  validate_recipe "${recipe}"

  if target_requested searxng "$@"; then
    docker compose -f "${STACK_DIR}/compose.yaml" up -d searxng
  fi
  if target_requested qwen "$@"; then
    case "${recipe}" in
      sglang)
        start_qwen
        wait_for_qwen
        ;;
      exl3) start_qwen_full ;;
      ninfer) start_qwen_ninfer ;;
    esac
    sync_harness_model "${recipe}"
  fi
  if target_requested harness "$@"; then
    if (( WORK_MODE )); then start_work_harness; else start_harness; fi
  fi
}

stop_targets() {
  local recipe="$1"
  shift
  local stop_result=0

  validate_targets "$@"

  if target_requested harness "$@"; then
    if (( WORK_MODE )); then stop_work_harness || stop_result=$?; else stop_harness || stop_result=$?; fi
  fi
  if target_requested qwen "$@"; then
    case "${recipe}" in
      sglang)
        docker stop "${QWEN_CONTAINER}" >/dev/null 2>&1 || true
        printf 'Qwen sglang stopped; its CUDA allocation has been released.\n'
        ;;
      exl3)
        docker stop --time 60 "${QWEN_FULL_CONTAINER}" >/dev/null 2>&1 || true
        printf 'Qwen EXL3 stopped; its CUDA allocation has been released.\n'
        ;;
      ninfer)
        docker stop --time 60 "${QWEN_NINFER_CONTAINER}" >/dev/null 2>&1 || true
        printf 'Qwen NInfer stopped; its CUDA allocation has been released.\n'
        ;;
      "")
        docker stop "${QWEN_CONTAINER}" >/dev/null 2>&1 || true
        docker stop --time 60 "${QWEN_FULL_CONTAINER}" >/dev/null 2>&1 || true
        docker stop --time 60 "${QWEN_NINFER_CONTAINER}" >/dev/null 2>&1 || true
        printf 'All Qwen recipes stopped; their CUDA allocations have been released.\n'
        ;;
    esac
  fi
  if target_requested searxng "$@"; then
    docker compose -f "${STACK_DIR}/compose.yaml" stop searxng >/dev/null
    printf 'SearXNG stopped.\n'
  fi
  return "${stop_result}"
}

status() {
  if systemctl --user is-active --quiet "${HARNESS_UNIT}"; then
    printf 'Harness: running at %s\n\n' "${HARNESS_URL}"
  elif curl -fsS --max-time 2 "${HARNESS_URL}" >/dev/null 2>&1; then
    printf 'Harness: responding at %s, but not managed by this helper\n\n' "${HARNESS_URL}"
  else
    printf 'Harness: stopped\n\n'
  fi
  if systemctl --user is-active --quiet "${WORK_HARNESS_UNIT}"; then
    printf 'Work Harness: running at %s\n\n' "${WORK_HARNESS_URL}"
  elif curl -fsS --max-time 2 "${WORK_HARNESS_URL}" >/dev/null 2>&1; then
    printf 'Work Harness: responding at %s, but not managed by this helper\n\n' "${WORK_HARNESS_URL}"
  else
    printf 'Work Harness: stopped\n\n'
  fi
  docker ps -a --filter "name=^/${QWEN_CONTAINER}$" --filter "name=^/${QWEN_FULL_CONTAINER}$" \
    --filter "name=^/${QWEN_NINFER_CONTAINER}$" \
    --filter "name=^/qwen-searxng$" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
  printf '\nGPU processes:\n'
  nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader 2>/dev/null || true
}

logs() {
  local target="${1:-harness}"
  local container_name

  case "${target}" in
    harness)
      if (( WORK_MODE )); then
        journalctl --user -u "${WORK_HARNESS_UNIT}" -n 100 --no-pager
      else
        journalctl --user -u "${HARNESS_UNIT}" -n 100 --no-pager
      fi
      ;;
    qwen)
      for container_name in "${QWEN_CONTAINER}" "${QWEN_FULL_CONTAINER}" "${QWEN_NINFER_CONTAINER}"; do
        if container_running "${container_name}"; then
          docker logs --tail 100 "${container_name}"
          return
        fi
      done
      printf 'No Qwen recipe is running.\n' >&2
      return 1
      ;;
    searxng)
      docker logs --tail 100 qwen-searxng
      ;;
    *)
      printf 'Unknown log target: %s (expected qwen, harness, or searxng)\n' "${target}" >&2
      return 2
      ;;
  esac
}

recipes() {
  cat <<'EOF'
Available Qwen recipes

  RECIPE    ENGINE   WEIGHTS       KV    MAX CONTEXT   DESKTOP CONTEXT   VISION   SPECULATION
  sglang*   SGLang   NVFP4         FP8       122,880           122,880   yes      DSpark-7
  exl3      vLLM     EXL3 K5/K6    FP8       262,144           155,648   yes      MTP-3
  ninfer    NInfer   NVFP4         INT8      252,928           172,032   no       MTP-3

  * Default recipe

  RECIPE    SERVED MODEL ID
  sglang    qwen3.8-27b-sglang-nvfp4-122880
  exl3      qwen3.8-27b-vllm-exl3-k5k6-262144
  ninfer    qwen3.8-27b-ninfer-nvfp4-252928

DESKTOP CONTEXT is selected by --desktop-use. SGLang is unchanged because its
normal profile is already suitable for desktop use. EXL3 and NInfer reserve
roughly 5 GiB of VRAM for the graphical desktop. Only one recipe runs at a time;
all expose their OpenAI-compatible API at http://127.0.0.1:30000/v1.
Harness lists only the recipe most recently started with the qwen target.
EOF
}

github_login() {
  command -v gh >/dev/null 2>&1 || { printf 'GitHub CLI (gh) is required.\n' >&2; return 1; }
  GH_CONFIG_DIR="${WORK_GH_CONFIG_DIR}" gh auth login -h github.com --web --scopes repo,read:org
}

github_status() {
  command -v gh >/dev/null 2>&1 || { printf 'GitHub CLI (gh) is required.\n' >&2; return 1; }
  GH_CONFIG_DIR="${WORK_GH_CONFIG_DIR}" gh auth status -h github.com
}

usage() {
  cat <<'EOF'
local-ai - manage the local Qwen stack

USAGE
  local-ai start [--work] [--recipe RECIPE] [--desktop-use] [TARGET ...]
  local-ai stop [--work] [--recipe RECIPE] [TARGET ...]
  local-ai logs [--work] [TARGET]
  local-ai prepare RECIPE
  local-ai COMMAND

COMMANDS
  start             Start one or more targets (defaults to all)
  stop              Stop one or more targets (defaults to all)
  prepare           Download/build one recipe without starting it
  recipes           List recipes and their main characteristics
  github-login      Sign the isolated work profile into GitHub
  github-status     Check the isolated work-profile GitHub login
  dashboard         Open the interactive status, logs, and GPU dashboard
  status            Show Harness, container, and GPU-process status
  logs [--work] [TARGET]
                    Show 100 log lines for qwen, harness, or searxng
  help              Show this help

OPTIONS
  --recipe RECIPE   Qwen recipe: sglang (default), exl3, or ninfer
  --work            Select the isolated work Harness instead of the personal one
  --desktop-use     Reserve about 5 GiB of VRAM with EXL3/NInfer; SGLang is
                    unchanged. This does not make gaming alongside Qwen viable.

TARGETS
  qwen              Model server at http://127.0.0.1:30000/v1
  harness           Selected Harness: personal, or work when --work is present
  searxng           Private search service at http://127.0.0.1:8888
  all               Qwen, selected Harness, and SearXNG (the default)

EXAMPLES
  local-ai start qwen harness
  local-ai start --recipe exl3 qwen harness
  cd COMPANY_REPO && local-ai start --work --recipe exl3 --desktop-use qwen harness searxng
  local-ai start --recipe ninfer --desktop-use qwen harness searxng
  local-ai stop qwen
  local-ai prepare ninfer
  local-ai recipes
  local-ai github-login
  local-ai logs --work harness
  local-ai dashboard
EOF
}

case "${1:-}" in
  start)
    shift
    parse_service_arguments start "$@"
    start_targets "${SELECTED_RECIPE}" "${PARSED_TARGETS[@]}"
    ;;
  prepare)
    shift
    (( $# == 1 )) || { usage; exit 2; }
    validate_recipe "$1"
    case "$1" in
      sglang) prepare_qwen_sglang ;;
      exl3) prepare_qwen_full ;;
      ninfer) prepare_qwen_ninfer ;;
    esac
    ;;
  stop)
    shift
    parse_service_arguments stop "$@"
    stop_targets "${SELECTED_RECIPE}" "${PARSED_TARGETS[@]}"
    ;;
  status) status ;;
  logs)
    shift
    WORK_MODE=0
    if [[ "${1:-}" == "--work" ]]; then WORK_MODE=1; shift; fi
    (( $# <= 1 )) || { usage >&2; exit 2; }
    logs "${1:-harness}"
    ;;
  dashboard)
    shift
    (( $# == 0 )) || { usage >&2; exit 2; }
    exec python3 "${STACK_DIR}/dashboard.py"
    ;;
  recipes) recipes ;;
  github-login) github_login ;;
  github-status) github_status ;;
  help|-h|--help) usage ;;
  "") usage; exit 2 ;;
  *)
    printf 'Unknown command: %s\n\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
