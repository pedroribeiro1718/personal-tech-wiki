requested() { local x; for x in "${TARGETS[@]}"; do [[ "$x" == "$1" || "$x" == all ]] && return; done; return 1; }

compose() {
  local recipe="$1"; shift
  case "$recipe" in
    exl3) QWEN_FULL_PATCH_DIR="$EXL3_DIR" docker compose -f "$STACK/${COMPOSE[$recipe]}" "$@" ;;
    ninfer) QWEN_NINFER_MODEL_FILE="$NINFER38_FILE" docker compose -f "$STACK/${COMPOSE[$recipe]}" "$@" ;;
    udq4) QWEN_MODEL_DIR="$UDQ4_DIR" docker compose -f "$STACK/${COMPOSE[$recipe]}" "$@" ;;
    a3b) QWEN_MODEL_FILE="$A3B_FILE" docker compose -f "$STACK/${COMPOSE[$recipe]}" "$@" ;;
    *) docker compose -f "$STACK/${COMPOSE[$recipe]}" "$@" ;;
  esac
}

download() {
  local url="$1" file="$2" size="$3" sha="$4" current=0
  if [[ -f "$file" ]] && [[ "$(stat -c %s "$file")" == "$size" ]] &&
    printf '%s  %s\n' "$sha" "$file" | sha256sum -c - >/dev/null; then return; fi
  [[ -f "$file" ]] && current="$(stat -c %s "$file")"
  (( current < size )) || die "Invalid artifact at $file; move it aside and retry."
  mkdir -p "$(dirname -- "$file")"
  printf 'Downloading %s (%s/%s bytes)\n' "$(basename -- "$file")" "$current" "$size"
  if command -v aria2c >/dev/null; then
    aria2c -c --auto-file-renaming=false --file-allocation=none -x4 -s4 \
      --dir="$(dirname -- "$file")" --out="$(basename -- "$file")" "$url"
  else
    curl -fL --retry 3 -C - -o "$file" "$url"
  fi
  [[ "$(stat -c %s "$file")" == "$size" ]] || die "Wrong size: $file"
  printf '%s  %s\n' "$sha" "$file" | sha256sum -c - >/dev/null || die "Checksum failed: $file"
}

NINFER38_FILE="${CACHE}/ninfer-model-204e3d92c30d/qwen3_8_27b_nvfp4.ninfer"
A3B_FILE="${CACHE}/ninfer-model-3d960f7b670e/qwen3_6_35b_a3b.ninfer"
prepare_ninfer_artifact() {
  ensure_ninfer_image
  if [[ "$1" == ninfer ]]; then
    download "https://huggingface.co/neroued/Qwen3.8-27B-nvfp4-NInfer/resolve/204e3d92c30d9d05f3300d2f52e443ad1edf6ddf/qwen3_8_27b_nvfp4.ninfer?download=true" \
      "$NINFER38_FILE" 21492695040 bb3360522a06e136e0367f5703414d26272b7285c8a6ab6194135c17dbd81b32
  else
    download "https://huggingface.co/neroued/Qwen3.6-35B-A3B-NInfer/resolve/3d960f7b670ea706105571a822334a1f09759271/qwen3_6_35b_a3b.ninfer?download=true" \
      "$A3B_FILE" 22783246080 1fb9ea0b5b8561e49d9604115ec89e5d9f2b6f6434e32c37c57fffd480a325d2
  fi
}

ensure_ninfer_image() {
  local found
  found="$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$NINFER_IMAGE" 2>/dev/null || true)"
  [[ "$found" == "$NINFER_REV" ]] && return
  if [[ -d "$NINFER_SRC/.git" ]]; then
    [[ "$(git -C "$NINFER_SRC" rev-parse HEAD)" == "$NINFER_REV" ]] &&
      [[ -z "$(git -C "$NINFER_SRC" status --porcelain)" ]] ||
      die "NInfer cache is not the clean pinned revision: $NINFER_SRC"
  else
    [[ ! -e "$NINFER_SRC" ]] || die "Move aside invalid cache: $NINFER_SRC"
    mkdir -p "$CACHE"
    local tmp; tmp="$(mktemp -d "$CACHE/.ninfer.XXXXXX")"
    git clone --filter=blob:none --no-checkout https://github.com/Neroued/ninfer.git "$tmp/src"
    git -C "$tmp/src" checkout --detach "$NINFER_REV"
    mv "$tmp/src" "$NINFER_SRC"; rmdir "$tmp"
  fi
  docker build --build-arg "NINFER_SOURCE_REVISION=$NINFER_REV" \
    -f "$STACK/ninfer.Dockerfile" -t "$NINFER_IMAGE" "$NINFER_SRC"
}

prepare_exl3() {
  local base="https://raw.githubusercontent.com/malaiwah/qwen38-27b-exl3/$EXL3_REV/tools" item file sha
  local -a items=(
    "vllm-exl3-prefill-dispatch.py:2df9d0799fd323798cead1edb773cab556c94798eec263ee03ded35408c6e4ee"
    "vllm-qwen3_5-embed-quant-config.py:04d2bd587b37142f4f55a8d00b9f8c907309490168cb7fcdfde450531df2c9e7"
    "vllm-qwen3_5_mtp-embed-quant-config.py:0090dc131f0eaf439b24d50baf4def9f10b052864c76e695053d64f66b274bab"
    "vllm-mamba-align-scheduler.py:b431c1066dfee3ed56bfa7e71cc8606f9afadc300f22d7fc542c43835d1b22bf")
  mkdir -p "$EXL3_DIR/tools"
  for item in "${items[@]}"; do
    file="${item%%:*}"; sha="${item#*:}"
    if ! printf '%s  %s\n' "$sha" "$EXL3_DIR/tools/$file" | sha256sum -c - >/dev/null 2>&1; then
      curl -fL --retry 3 -o "$EXL3_DIR/tools/$file.part" "$base/$file"
      printf '%s  %s\n' "$sha" "$EXL3_DIR/tools/$file.part" | sha256sum -c - >/dev/null
      mv "$EXL3_DIR/tools/$file.part" "$EXL3_DIR/tools/$file"
    fi
  done
  compose exl3 pull --policy missing qwen-full
}

