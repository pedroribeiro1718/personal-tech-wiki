  download "$base/Qwen3.8-27B-UD-Q4_K_XL.gguf?download=true" "$UDQ4_DIR/Qwen3.8-27B-UD-Q4_K_XL.gguf" 17559178144 3f227079003add2511437e5b1e94812e363385225bf6a9b47b0054a72bc8b01e
  download "$base/mmproj-BF16.gguf?download=true" "$UDQ4_DIR/mmproj-BF16.gguf" 931146432 83ee4f4f205fa514161778c41df1ea14144faa0f713510893b63c2395f5c2d53
  download "$base/MTP/mtp-Qwen3.8-27B-Q4_0.gguf?download=true" "$UDQ4_DIR/mtp-Qwen3.8-27B-Q4_0.gguf" 1369590656 50d9ce5a6da381bbcfb31061cf73df94a90e6faf8efeddee379a9cb8f1501c6e
